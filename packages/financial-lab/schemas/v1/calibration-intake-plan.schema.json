{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.calibration_intake_plan.v1.schema.json",
  "title": "Synthetic empty calibration evidence intake plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "status", "readinessReportId", "slots", "summary", "realWorldState", "realDataRequestCreated", "financialUseAllowed", "executionAllowed", "parameterMutationAllowed"],
  "properties": {
    "schemaVersion": {"const": "asha.synthetic.calibration_intake_plan.v1"},
    "planId": {"type": "string", "pattern": "^ASHA_SYNTHETIC_CALIBRATION_INTAKE_[a-f0-9]{64}$"},
    "status": {"const": "synthetic_empty_intake_plan_only"},
    "readinessReportId": {"type": "string", "pattern": "^ASHA_SYNTHETIC_CALIBRATION_READINESS_[a-f0-9]{64}$"},
    "slots": {
      "type": "array", "minItems": 64, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gateId", "evidenceId", "ownerLabelFa", "state", "content"],
        "properties": {
          "gateId": {"type": "string", "pattern": "^G(0[1-9]|10)_[A-Z0-9_]+$"},
          "evidenceId": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "ownerLabelFa": {"type": "string", "minLength": 1},
          "state": {"const": "not_collected"},
          "content": {"type": "null"}
        }
      }
    },
    "summary": {"const": {"requiredCount": 64, "collectedCount": 0}},
    "realWorldState": {"const": "not_evaluated"},
    "realDataRequestCreated": {"const": false},
    "financialUseAllowed": {"const": false},
    "executionAllowed": {"const": false},
    "parameterMutationAllowed": {"const": false}
  }
}
