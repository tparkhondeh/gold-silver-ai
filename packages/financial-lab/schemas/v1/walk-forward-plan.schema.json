{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.walk_forward_plan.v1.schema.json",
  "title": "Asha synthetic-only walk-forward plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "status",
    "financialUseAllowed",
    "datasetReference",
    "methodologyReference",
    "parameters",
    "folds",
    "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.walk_forward_plan.v1" },
    "planId": { "type": "string", "pattern": "^ASHA_WALK_FORWARD_[a-f0-9]{64}$" },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "datasetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "contentFingerprint"],
      "properties": {
        "datasetId": { "type": "string", "pattern": "^ASHA_SYNTHETIC_[A-Z0-9_]{3,64}_V[1-9][0-9]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "methodologyReference": {
      "const": { "entityId": "STATUS_TBD", "version": 0, "approvalState": "unapproved" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumTrainPeriods", "testPeriods", "stepPeriods", "purgePeriods", "embargoPeriods", "mode"],
      "properties": {
        "minimumTrainPeriods": { "type": "integer", "minimum": 3 },
        "testPeriods": { "type": "integer", "minimum": 1 },
        "stepPeriods": { "type": "integer", "minimum": 1 },
        "purgePeriods": { "type": "integer", "minimum": 0 },
        "embargoPeriods": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["rolling", "anchored"] }
      }
    },
    "folds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foldIndex",
          "trainStartIndex",
          "trainEndIndex",
          "trainingAvailabilityCutoffIndex",
          "trainObservationCount",
          "trainObservationFingerprint",
          "purgeStartIndex",
          "purgeEndIndex",
          "testStartIndex",
          "testEndIndex",
          "embargoStartIndex",
          "embargoEndIndex"
        ],
        "properties": {
          "foldIndex": { "type": "integer", "minimum": 0 },
          "trainStartIndex": { "type": "integer", "minimum": 0 },
          "trainEndIndex": { "type": "integer", "minimum": 0 },
          "trainingAvailabilityCutoffIndex": { "type": "integer", "minimum": 0 },
          "trainObservationCount": { "type": "integer", "minimum": 1 },
          "trainObservationFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "purgeStartIndex": { "type": ["integer", "null"], "minimum": 0 },
          "purgeEndIndex": { "type": ["integer", "null"], "minimum": 0 },
          "testStartIndex": { "type": "integer", "minimum": 0 },
          "testEndIndex": { "type": "integer", "minimum": 0 },
          "embargoStartIndex": { "type": ["integer", "null"], "minimum": 0 },
          "embargoEndIndex": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "reasonCodes": {
      "const": [
        "METHODOLOGY_NOT_APPROVED",
        "REAL_FINANCIAL_USE_DISABLED",
        "SYNTHETIC_DATA_ONLY",
        "WALK_FORWARD_MECHANICS_ONLY"
      ]
    }
  }
}
