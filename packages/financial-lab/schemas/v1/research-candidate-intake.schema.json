{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.methodology.research_candidate_intake.v1.schema.json",
  "title": "Asha research-candidate intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "intakeId", "intakeVersion", "status",
    "financialUseAllowed", "executionAllowed", "implementationAllowed",
    "selectionAllowed", "methodologyApprovalState", "gapReportReference",
    "candidates", "summary", "intakePolicy", "reasonCodes"
  ],
  "$defs": {
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "referenceList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9_.:-]{2,160}$"
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "asha.methodology.research_candidate_intake.v1" },
    "intakeId": {
      "type": "string",
      "pattern": "^ASHA_RESEARCH_CANDIDATE_INTAKE_[a-f0-9]{64}$"
    },
    "intakeVersion": { "type": "integer", "minimum": 1 },
    "status": { "const": "research_intake_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "implementationAllowed": { "const": false },
    "selectionAllowed": { "const": false },
    "methodologyApprovalState": { "const": "unapproved" },
    "gapReportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "schemaVersion"],
      "properties": {
        "reportId": {
          "type": "string",
          "pattern": "^ASHA_METHODOLOGY_EVIDENCE_GAP_REPORT_[a-f0-9]{64}$"
        },
        "schemaVersion": { "const": "asha.methodology.evidence_gap_report.v1" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId", "candidateVersion", "displayName", "researchQuestion",
          "searchRecord", "authoritativeSources", "candidateScope",
          "nonEquivalenceLimits", "criterionGaps", "implementationStatus",
          "iranFitnessStatus", "selectionEligibility"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^ASHA_RESEARCH_CANDIDATE_[A-Z0-9_]{3,80}_V[1-9][0-9]*$"
          },
          "candidateVersion": { "type": "integer", "minimum": 1 },
          "displayName": { "type": "string", "pattern": "^\\[RESEARCH ONLY\\] " },
          "researchQuestion": { "type": "string", "minLength": 1, "maxLength": 500 },
          "searchRecord": {
            "type": "object",
            "additionalProperties": false,
            "required": ["searchedOn", "searchMethod", "searchScope", "reviewedByRole"],
            "properties": {
              "searchedOn": { "type": "string", "format": "date" },
              "searchMethod": { "const": "manual_recorded_no_network_automation" },
              "searchScope": { "type": "string", "minLength": 1, "maxLength": 500 },
              "reviewedByRole": {
                "enum": [
                  "human_researcher",
                  "human_researcher_with_ai_discovery_support"
                ]
              }
            }
          },
          "authoritativeSources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId", "sourceVersion", "sourceType", "title",
                "authoringBody", "locator", "publishedOrRevisedOn",
                "reviewedOn", "currencyStatus"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^ASHA_METHODOLOGY_SOURCE_[A-Z0-9_]{3,80}_V[1-9][0-9]*$"
                },
                "sourceVersion": { "type": "integer", "minimum": 1 },
                "sourceType": {
                  "enum": [
                    "official_method_documentation",
                    "peer_reviewed_primary_research",
                    "regulatory_or_standards_guidance"
                  ]
                },
                "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                "authoringBody": { "type": "string", "minLength": 1, "maxLength": 500 },
                "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
                "publishedOrRevisedOn": { "type": "string", "format": "date" },
                "reviewedOn": { "type": "string", "format": "date" },
                "currencyStatus": {
                  "enum": [
                    "current_at_review_date", "superseded",
                    "unknown_requires_review"
                  ]
                }
              }
            }
          },
          "candidateScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanismClaim", "comparisonBoundary", "excludedClaims"],
            "properties": {
              "mechanismClaim": { "type": "string", "minLength": 1, "maxLength": 500 },
              "comparisonBoundary": { "type": "string", "minLength": 1, "maxLength": 500 },
              "excludedClaims": {
                "const": [
                  "CURRENT_BEST_METHOD",
                  "IRAN_FITNESS",
                  "OPERATIONAL_PERFORMANCE",
                  "SELECTION_OR_APPROVAL"
                ]
              }
            }
          },
          "nonEquivalenceLimits": { "$ref": "#/$defs/textList" },
          "criterionGaps": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId", "evidenceStatus", "evidenceReferences",
                "unresolvedRequirements"
              ],
              "properties": {
                "criterionId": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,80}$"
                },
                "evidenceStatus": {
                  "enum": ["documented_only", "not_evaluated"]
                },
                "evidenceReferences": { "$ref": "#/$defs/referenceList" },
                "unresolvedRequirements": { "$ref": "#/$defs/textList" }
              }
            }
          },
          "implementationStatus": { "const": "not_implemented" },
          "iranFitnessStatus": { "const": "not_evaluated" },
          "selectionEligibility": {
            "const": "blocked_owner_methodology_decision_required"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCount", "implementedCount", "selectionEligibleCount"],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 1 },
        "implementedCount": { "const": 0 },
        "selectionEligibleCount": { "const": 0 }
      }
    },
    "intakePolicy": {
      "const": "manual_primary_source_intake_no_score_rank_selection_or_implementation"
    },
    "reasonCodes": {
      "const": [
        "CANDIDATE_LIST_IS_NOT_A_RANKING",
        "CURRENT_BEST_NOT_ESTABLISHED",
        "IMPLEMENTATION_NOT_AUTHORIZED",
        "IRAN_FITNESS_NOT_ESTABLISHED",
        "OWNER_METHODOLOGY_DECISION_REQUIRED",
        "PRIMARY_SOURCE_REVIEW_REQUIRED"
      ]
    }
  }
}
