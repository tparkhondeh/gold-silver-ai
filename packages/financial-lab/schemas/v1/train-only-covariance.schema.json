{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.train_only_covariance.v1.schema.json",
  "title": "Asha synthetic train-only population covariance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "covarianceId", "status", "financialUseAllowed",
    "executionAllowed", "decisionState", "datasetReference", "returnMatrixReference",
    "walkForwardPlanReference", "standardizerReference", "methodologyReference",
    "foldIndex", "trainingFeatureStartIndex", "trainingFeatureEndIndex", "parameters",
    "instrumentIds", "rows", "zeroVarianceInstrumentIds", "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.train_only_covariance.v1" },
    "covarianceId": { "type": "string", "pattern": "^ASHA_TRAIN_ONLY_COVARIANCE_[a-f0-9]{64}$" },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "decisionState": { "const": "no_decision" },
    "datasetReference": { "type": "object" },
    "returnMatrixReference": { "type": "object" },
    "walkForwardPlanReference": { "type": "object" },
    "standardizerReference": { "type": "object" },
    "methodologyReference": {
      "const": { "entityId": "STATUS_TBD", "version": 0, "approvalState": "unapproved" }
    },
    "foldIndex": { "type": "integer", "minimum": 0 },
    "trainingFeatureStartIndex": { "type": "integer", "minimum": 1 },
    "trainingFeatureEndIndex": { "type": "integer", "minimum": 1 },
    "parameters": {
      "const": {
        "estimator": "population_covariance_v1",
        "denominator": "training_observation_count",
        "rounding": "half_even_12_decimals"
      }
    },
    "instrumentIds": {
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrumentId", "values"],
        "properties": {
          "instrumentId": { "type": "string" },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instrumentId", "value"],
              "properties": {
                "instrumentId": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "zeroVarianceInstrumentIds": {
      "type": "array", "items": { "type": "string" }
    },
    "reasonCodes": {
      "const": [
        "COVARIANCE_FEATURE_ONLY", "METHODOLOGY_NOT_APPROVED", "NO_FINANCIAL_DECISION",
        "REAL_FINANCIAL_USE_DISABLED", "SYNTHETIC_DATA_ONLY", "TRAIN_ONLY_FIT"
      ]
    }
  }
}
