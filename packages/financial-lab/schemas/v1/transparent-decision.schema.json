{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.transparent_decision.v1.schema.json",
  "title": "Asha transparent guarded synthetic decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decisionId", "status", "financialUseAllowed",
    "executionAllowed", "decisionState", "methodologyReference", "inputReference",
    "horizon", "parameters", "assetDecisions", "overallDecision",
    "portfolioMetrics", "evidenceState", "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.transparent_decision.v1" },
    "decisionId": { "type": "string", "pattern": "^ASHA_TRANSPARENT_DECISION_[a-f0-9]{64}$" },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "decisionState": { "const": "synthetic_proposal_only" },
    "methodologyReference": {
      "const": {
        "entityId": "ASHA_TRANSPARENT_GUARDED_DECISION_V1",
        "version": 1,
        "selectionState": "owner_authorized_laboratory_proposal",
        "realUseApprovalState": "not_approved"
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "contentFingerprint"],
      "properties": {
        "datasetId": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "horizon": { "enum": ["short", "long"] },
    "parameters": { "type": "object" },
    "assetDecisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrumentId", "displayName", "assetClassId", "action", "horizon",
          "currentWeightPercent", "proposedWeightPercent", "changePercentPoint",
          "suggestedAmountToman", "decisionScore", "factorContributions",
          "primaryReasonCodes", "actionReasonCodes", "invalidationRules",
          "sameClassAlternativeId", "crossClassAlternativeId",
          "evidenceAdequacyPercent", "iranValidationStatus"
        ],
        "properties": {
          "instrumentId": { "type": "string" },
          "displayName": { "type": "string" },
          "assetClassId": { "type": "string" },
          "action": { "enum": ["increase", "reduce", "hold"] },
          "horizon": { "enum": ["short", "long"] },
          "currentWeightPercent": { "type": "string" },
          "proposedWeightPercent": { "type": "string" },
          "changePercentPoint": { "type": "string" },
          "suggestedAmountToman": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,14})$" },
          "decisionScore": { "type": "string" },
          "factorContributions": { "type": "array", "maxItems": 8 },
          "primaryReasonCodes": { "type": "array", "uniqueItems": true },
          "actionReasonCodes": { "type": "array", "uniqueItems": true },
          "invalidationRules": { "type": "array", "minItems": 3, "uniqueItems": true },
          "sameClassAlternativeId": { "type": ["string", "null"] },
          "crossClassAlternativeId": { "type": ["string", "null"] },
          "evidenceAdequacyPercent": { "const": "100.000000" },
          "iranValidationStatus": { "const": "not_evaluated" }
        }
      }
    },
    "overallDecision": { "type": "object" },
    "portfolioMetrics": { "type": "object" },
    "evidenceState": {
      "type": "object",
      "required": [
        "syntheticFactorCoveragePercent", "realMarketEvidenceStatus",
        "iranCalibrationStatus", "missingRequirements"
      ],
      "properties": {
        "syntheticFactorCoveragePercent": { "const": "100.000000" },
        "realMarketEvidenceStatus": { "const": "not_evaluated" },
        "iranCalibrationStatus": { "const": "not_evaluated" },
        "missingRequirements": { "type": "array", "minItems": 1, "uniqueItems": true }
      }
    },
    "reasonCodes": {
      "const": [
        "DETERMINISTIC_CODE_ONLY", "FINANCIAL_PERFORMANCE_NOT_ESTABLISHED",
        "IRAN_VALIDATION_REQUIRED", "LABORATORY_PROPOSAL_NOT_REAL_RECOMMENDATION",
        "REAL_FINANCIAL_USE_DISABLED", "SYNTHETIC_DATA_ONLY"
      ]
    }
  }
}
