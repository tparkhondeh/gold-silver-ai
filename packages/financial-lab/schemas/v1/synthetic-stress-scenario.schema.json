{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.stress_scenario.v1.schema.json",
  "title": "Asha explicit synthetic stress scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scenarioId", "scenarioVersion", "scenarioKind", "purpose",
    "financialUseAllowed", "coveragePolicy", "shocks", "contentFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.stress_scenario.v1" },
    "scenarioId": {
      "type": "string",
      "pattern": "^ASHA_SYNTHETIC_STRESS_SCENARIO_[A-Z0-9_]{2,64}_V[1-9][0-9]*$"
    },
    "scenarioVersion": { "type": "integer", "minimum": 1 },
    "scenarioKind": { "const": "explicit_additive_return_shocks" },
    "purpose": { "const": "crisis_mechanics_test" },
    "financialUseAllowed": { "const": false },
    "coveragePolicy": { "const": "unspecified_entries_are_explicit_zero" },
    "shocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["periodIndex", "instrumentId", "additiveReturnShock"],
        "properties": {
          "periodIndex": { "type": "integer", "minimum": 1 },
          "instrumentId": { "type": "string", "pattern": "^SYNTH_[A-Z0-9_]{2,64}$" },
          "additiveReturnShock": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]{0,11})\\.[0-9]{12}$"
          }
        }
      }
    },
    "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
