{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.calibration_gate_result.v1.schema.json",
  "title": "Asha synthetic calibration gate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "resultId", "status", "manifestReference", "evidenceReference",
    "financialUseAllowed", "executionAllowed", "parameterMutationAllowed",
    "gateResults", "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.calibration_gate_result.v1" },
    "resultId": { "type": "string", "pattern": "^ASHA_SYNTHETIC_CALIBRATION_GATE_RESULT_[a-f0-9]{64}$" },
    "status": { "const": "synthetic_gate_mechanics_only" },
    "manifestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "manifestVersion", "schemaVersion"],
      "properties": {
        "manifestId": { "type": "string", "pattern": "^ASHA_IRAN_CALIBRATION_MANIFEST_[a-f0-9]{64}$" },
        "manifestVersion": { "const": 1 },
        "schemaVersion": { "const": "asha.synthetic.iran_calibration_manifest.v1" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "schemaVersion"],
      "properties": {
        "bundleId": { "type": "string", "pattern": "^ASHA_SYNTHETIC_CALIBRATION_EVIDENCE_[a-f0-9]{64}$" },
        "schemaVersion": { "const": "asha.synthetic.calibration_gate_evidence.v1" }
      }
    },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "parameterMutationAllowed": { "const": false },
    "gateResults": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId", "evidenceState", "mechanicalState", "failedCheckIds",
          "missingCheckIds", "reasonCodes", "realWorldState"
        ],
        "properties": {
          "gateId": { "type": "string" },
          "evidenceState": { "enum": ["satisfied", "failed", "missing"] },
          "mechanicalState": { "enum": ["passed", "failed", "blocked"] },
          "failedCheckIds": { "type": "array", "uniqueItems": true },
          "missingCheckIds": { "type": "array", "uniqueItems": true },
          "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true },
          "realWorldState": { "const": "not_evaluated" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanicalState", "passedGateCount", "totalGateCount",
        "firstBlockingGateId", "realCalibrationState", "promotionState", "reasonCodes"
      ],
      "properties": {
        "mechanicalState": { "enum": ["passed", "failed", "blocked"] },
        "passedGateCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "totalGateCount": { "const": 10 },
        "firstBlockingGateId": { "type": ["string", "null"] },
        "realCalibrationState": { "const": "not_evaluated" },
        "promotionState": { "const": "blocked_in_synthetic_evaluator" },
        "reasonCodes": {
          "const": [
            "REAL_IRAN_EVIDENCE_NOT_EVALUATED",
            "SYNTHETIC_RESULTS_CANNOT_AUTHORIZE_FINANCIAL_USE",
            "LATER_OWNER_ADR_REQUIRED"
          ]
        }
      }
    }
  }
}
