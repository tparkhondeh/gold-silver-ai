{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.methodology.evaluation_rubric.v1.schema.json",
  "title": "Asha methodology evaluation rubric v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "rubricId", "status", "financialUseAllowed",
    "executionAllowed", "selectionAllowed", "methodologyApprovalState",
    "criteria", "scoringPolicy", "thresholdPolicy", "aggregationPolicy",
    "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.methodology.evaluation_rubric.v1" },
    "rubricId": {
      "type": "string",
      "pattern": "^ASHA_METHODOLOGY_RUBRIC_[a-f0-9]{64}$"
    },
    "status": { "const": "research_governance_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "selectionAllowed": { "const": false },
    "methodologyApprovalState": { "const": "unapproved" },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId", "plainLanguageQuestion", "requiredEvidenceKinds",
          "iranSpecific"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,80}$"
          },
          "plainLanguageQuestion": { "type": "string", "minLength": 1 },
          "requiredEvidenceKinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "iranSpecific": { "type": "boolean" }
        }
      }
    },
    "scoringPolicy": { "const": "not_defined_owner_approval_required" },
    "thresholdPolicy": { "const": "not_defined_owner_approval_required" },
    "aggregationPolicy": { "const": "none_criterion_evidence_only" },
    "reasonCodes": {
      "const": [
        "AGGREGATE_SCORE_NOT_DEFINED",
        "IRAN_VALIDATION_REQUIRED",
        "METHODOLOGY_NOT_APPROVED",
        "OWNER_APPROVAL_REQUIRED",
        "PERFORMANCE_ALONE_INSUFFICIENT",
        "RUBRIC_PREDECLARED_BEFORE_EVALUATION",
        "WEIGHTS_AND_THRESHOLDS_NOT_DEFINED"
      ]
    }
  }
}
