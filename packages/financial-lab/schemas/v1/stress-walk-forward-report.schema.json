{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.stress_walk_forward_report.v1.schema.json",
  "title": "Asha synthetic multi-fold multi-scenario stress report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reportId", "status", "financialUseAllowed",
    "executionAllowed", "decisionState", "benchmarkId", "datasetReference",
    "returnMatrixReference", "walkForwardPlanReference", "methodologyReference",
    "parameters", "summary", "foldResults", "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.stress_walk_forward_report.v1" },
    "reportId": {
      "type": "string",
      "pattern": "^ASHA_STRESS_WALK_FORWARD_REPORT_[a-f0-9]{64}$"
    },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "decisionState": { "const": "no_decision" },
    "benchmarkId": {
      "enum": [
        "ASHA_BENCHMARK_INVERSE_VOLATILITY_CONTROL_V1",
        "ASHA_BENCHMARK_HRP_CONTROL_V1",
        "ASHA_BENCHMARK_MINIMUM_CVAR_CONTROL_V1"
      ]
    },
    "datasetReference": { "type": "object" },
    "returnMatrixReference": { "type": "object" },
    "walkForwardPlanReference": { "type": "object" },
    "methodologyReference": {
      "const": { "entityId": "STATUS_TBD", "version": 0, "approvalState": "unapproved" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foldPolicy", "tailCount", "weightStep"],
      "properties": {
        "foldPolicy": { "type": "string" },
        "tailCount": { "type": ["integer", "null"] },
        "weightStep": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foldCount", "scenarioCellCount", "firstTestIndex", "lastTestIndex",
        "aggregationPolicy"
      ],
      "properties": {
        "foldCount": { "type": "integer", "minimum": 1 },
        "scenarioCellCount": { "type": "integer", "minimum": 2 },
        "firstTestIndex": { "type": "integer", "minimum": 1 },
        "lastTestIndex": { "type": "integer", "minimum": 1 },
        "aggregationPolicy": { "const": "none_fold_or_scenario_metrics_only" }
      }
    },
    "foldResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foldIndex", "trainStartIndex", "trainEndIndex", "testStartIndex",
          "testEndIndex", "weightSetReference", "stressSuiteReference",
          "scenarioCount", "scenarioResults"
        ],
        "properties": {
          "foldIndex": { "type": "integer", "minimum": 0 },
          "trainStartIndex": { "type": "integer", "minimum": 0 },
          "trainEndIndex": { "type": "integer", "minimum": 0 },
          "testStartIndex": { "type": "integer", "minimum": 1 },
          "testEndIndex": { "type": "integer", "minimum": 1 },
          "weightSetReference": { "type": "object" },
          "stressSuiteReference": { "type": "object" },
          "scenarioCount": { "type": "integer", "minimum": 2, "maximum": 16 },
          "scenarioResults": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stressScenarioReference", "stressedReturnMatrixReference",
                "stressEvaluationReference", "metrics"
              ],
              "properties": {
                "stressScenarioReference": { "type": "object" },
                "stressedReturnMatrixReference": { "type": "object" },
                "stressEvaluationReference": { "type": "object" },
                "metrics": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "reasonCodes": {
      "const": [
        "COMPARISON_CONTROL_ONLY", "EXPLICIT_SYNTHETIC_SCENARIOS_ONLY",
        "METHODOLOGY_NOT_APPROVED", "NO_FINANCIAL_DECISION",
        "NO_FOLD_OR_SCENARIO_AGGREGATION", "NO_RANKING_OR_THRESHOLD",
        "REAL_FINANCIAL_USE_DISABLED", "SYNTHETIC_DATA_ONLY",
        "WALK_FORWARD_STRESS_EVALUATION_ONLY"
      ]
    }
  }
}
