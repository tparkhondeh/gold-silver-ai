{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.weighted_control_evaluation.v1.schema.json",
  "title": "Asha synthetic weighted comparison-control evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evaluationId", "status", "financialUseAllowed",
    "executionAllowed", "decisionState", "benchmarkId", "datasetReference",
    "returnMatrixReference", "walkForwardPlanReference", "weightSetReference",
    "methodologyReference", "foldIndex", "testStartIndex", "testEndIndex",
    "periodResults", "metrics", "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.weighted_control_evaluation.v1" },
    "evaluationId": { "type": "string", "pattern": "^ASHA_WEIGHTED_CONTROL_EVAL_[a-f0-9]{64}$" },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "executionAllowed": { "const": false },
    "decisionState": { "const": "no_decision" },
    "benchmarkId": {
      "enum": [
        "ASHA_BENCHMARK_INVERSE_VOLATILITY_CONTROL_V1",
        "ASHA_BENCHMARK_HRP_CONTROL_V1"
      ]
    },
    "datasetReference": { "type": "object" },
    "returnMatrixReference": { "type": "object" },
    "walkForwardPlanReference": { "type": "object" },
    "weightSetReference": { "type": "object" },
    "methodologyReference": {
      "const": { "entityId": "STATUS_TBD", "version": 0, "approvalState": "unapproved" }
    },
    "foldIndex": { "type": "integer", "minimum": 0 },
    "testStartIndex": { "type": "integer", "minimum": 1 },
    "testEndIndex": { "type": "integer", "minimum": 1 },
    "periodResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["periodIndex", "weightedReturn", "wealthIndex"],
        "properties": {
          "periodIndex": { "type": "integer", "minimum": 1 },
          "weightedReturn": { "type": "string" },
          "wealthIndex": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodCount", "cumulativeChangePercent", "maximumDrawdownPercent"],
      "properties": {
        "periodCount": { "type": "integer", "minimum": 1 },
        "cumulativeChangePercent": { "type": "string" },
        "maximumDrawdownPercent": { "type": "string" }
      }
    },
    "reasonCodes": {
      "const": [
        "COMPARISON_CONTROL_ONLY", "METHODOLOGY_NOT_APPROVED", "NO_FINANCIAL_DECISION",
        "REAL_FINANCIAL_USE_DISABLED", "SYNTHETIC_DATA_ONLY", "TEST_FOLD_EVALUATION_ONLY"
      ]
    }
  }
}
