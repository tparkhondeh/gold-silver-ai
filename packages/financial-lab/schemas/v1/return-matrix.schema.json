{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldsilver.wealthos.ir/contracts/asha.synthetic.return_matrix.v1.schema.json",
  "title": "Asha point-in-time synthetic return matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matrixId",
    "status",
    "financialUseAllowed",
    "datasetReference",
    "methodologyReference",
    "startIndex",
    "endIndex",
    "instrumentIds",
    "rows",
    "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "asha.synthetic.return_matrix.v1" },
    "matrixId": { "type": "string", "pattern": "^ASHA_RETURN_MATRIX_[a-f0-9]{64}$" },
    "status": { "const": "evaluation_only" },
    "financialUseAllowed": { "const": false },
    "datasetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "contentFingerprint"],
      "properties": {
        "datasetId": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "methodologyReference": {
      "const": { "entityId": "STATUS_TBD", "version": 0, "approvalState": "unapproved" }
    },
    "startIndex": { "type": "integer", "minimum": 1 },
    "endIndex": { "type": "integer", "minimum": 1 },
    "instrumentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SYNTH_[A-Z0-9_]{2,64}$" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["periodIndex", "carriedForwardInstrumentIds", "returns"],
        "properties": {
          "periodIndex": { "type": "integer", "minimum": 1 },
          "carriedForwardInstrumentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SYNTH_[A-Z0-9_]{2,64}$" }
          },
          "returns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instrumentId", "value"],
              "properties": {
                "instrumentId": { "type": "string", "pattern": "^SYNTH_[A-Z0-9_]{2,64}$" },
                "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,11})\\.[0-9]{12}$" }
              }
            }
          }
        }
      }
    },
    "reasonCodes": {
      "const": [
        "FEATURE_MECHANICS_ONLY",
        "METHODOLOGY_NOT_APPROVED",
        "POINT_IN_TIME_ONLY",
        "REAL_FINANCIAL_USE_DISABLED",
        "SYNTHETIC_DATA_ONLY"
      ]
    }
  }
}
