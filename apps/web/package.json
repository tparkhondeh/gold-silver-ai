{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:private": "node scripts/build-private.mjs",
    "start:private": "node --experimental-strip-types scripts/start-private-server.mjs",
    "test:private-build": "node --experimental-strip-types scripts/test-private-build.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:coverage",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=app/**/*.ts --test-coverage-include=auth/**/*.ts --test-coverage-include=data/**/*.ts --test-coverage-include=db/**/*.ts --test-coverage-include=scripts/**/*.ts --test-coverage-include=worker/**/*.ts --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=80 --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-private --ignore-pattern .next",
    "configure:market-apis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-market-apis.ps1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate-postgres.mjs",
    "db:backup": "node --experimental-strip-types scripts/local-postgres.mjs backup",
    "local:run": "node --experimental-strip-types scripts/start-local-app.mjs",
    "identity:check-storage": "node --experimental-strip-types scripts/identity-storage.mjs --check",
    "identity:acceptance": "node --experimental-strip-types scripts/start-private-login-acceptance.mjs",
    "ops:check-local": "node --experimental-strip-types scripts/check-local-readiness.mjs",
    "ops:check-private": "node --experimental-strip-types scripts/check-private-readiness.mjs",
    "test:db": "node --experimental-strip-types --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.15.0",
    "drizzle-orm": "0.45.2",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.2.0",
    "vite": "8.2.4",
    "wrangler": "4.136.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    },
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "zod": "4.6.6",
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
