# Server-side only. Never expose these values in NEXT_PUBLIC_* variables.
# Run `npm run configure:market-apis` for hidden local input and safe .env.local storage.
GOLD_API_TOKEN=
NAVASAN_API_KEY=
# Set true only after revoking the credential pasted in chat and securely
# configuring a newly issued key. The application fails closed by default.
NAVASAN_KEY_ROTATION_CONFIRMED=false

# The current Navasan contract is TOMAN. Coin and mesghal thousand-toman scaling
# is fixed per symbol in the adapter and protected by range tests.
# Allowed values remain IRR or TOMAN for an explicitly changed provider contract.
NAVASAN_VALUE_UNIT=

# Current local plan. Missing or invalid values fall back to the safe free policy.
NAVASAN_PLAN=free

# Conservative free-plan default: 24000 seconds (6h40m) permits at most 112
# scheduled calls in any 31-day window, below the application's 115-call ceiling.
# Standard paid plan: 120 seconds. Gold paid plan: 30 seconds.
NAVASAN_REFRESH_SECONDS=24000

# Historical endpoints remain locked even when the live key is active. These are
# deliberately not configured by the setup script. Only after written storage/use
# permission and owner approval may both values be set by a governed change.
NAVASAN_HISTORY_EXECUTION_ENABLED=false
NAVASAN_HISTORY_LICENSE_REFERENCE=

# Navasan calls fail closed unless the protected local PostgreSQL runtime has
# migration 0010 and can append immutable quota reservations. The application uses
# at most 115 calls in any rolling 31-day window, leaving five calls of headroom.

# Local operator persistence. Keep disabled until a local PostgreSQL instance is
# migrated and its integration tests pass. DATABASE_URL must use a loopback host.
ASHA_OPERATOR_COMMIT_ENABLED=false
DATABASE_URL=
